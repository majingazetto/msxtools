<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Custom</manufacturer>
    <code>Custom_MSX1_64K_MultiSlot</code>
    <release_year>2026</release_year>
    <description>Custom MSX1 based on Sony HB-20P with 64KB RAM across
expanded slots. Slot 1 free for cartridges.
  Slot 0-0: BIOS + BASIC ROM (0x0000-0x7FFF)
  Slot 0-1: 16KB RAM page 0 (0x0000-0x3FFF)
  Slot 1  : external cartridge
  Slot 2-0: 16KB RAM page 1 (0x4000-0x7FFF)
  Slot 2-1: 16KB RAM page 2 (0x8000-0xBFFF)
  Slot 3  : 16KB RAM page 3 (0xC000-0xFFFF)
Slot switching via port 0xA8; subslot registers at 0xFFFF (slot 0) and
0xBFFF (slot 2) select the active subslot within each expanded slot.
</description>
    <type>MSX</type>
    <region>es</region>
  </info>

  <CassettePort/>

  <devices>

    <PPI id="ppi">
      <sound>
        <volume>16000</volume>
      </sound>
      <io base="0xA8" num="4"/>
      <keyboard_type>es</keyboard_type>
      <has_keypad>false</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>T6950PAL</version>
      <io base="0x98" num="2"/>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <sound>
        <volume>21000</volume>
      </sound>
      <io base="0xA0" num="4" type="IO"/>
      <ignorePortDirections>true</ignorePortDirections>
    </PSG>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <!-- Slot 0: expanded — BIOS ROM in subslot 0, page 0 RAM in subslot 1 -->
    <primary slot="0">

      <!-- Slot 0-0: BIOS + BASIC ROM (pages 0 and 1, 32KB) -->
      <secondary slot="0">
        <ROM id="MSX BIOS with BASIC ROM">
          <rom>
            <filename>hb-20p_basic-bios1.rom</filename>
            <sha1>63050d2d21214a721cc55f152c22b7be8061ac33</sha1>
          </rom>
          <mem base="0x0000" size="0x8000"/>
        </ROM>
      </secondary>

      <!-- Slot 0-1: 16KB RAM — page 0 (0x0000-0x3FFF) -->
      <secondary slot="1">
        <RAM id="RAM Page 0">
          <mem base="0x0000" size="0x4000"/>
        </RAM>
      </secondary>

    </primary>

    <!-- Slot 1: external cartridge port -->
    <primary external="true" slot="1"/>

    <!-- Slot 2: expanded — page 1 RAM in subslot 0, page 2 RAM in subslot 1 -->
    <primary slot="2">

      <!-- Slot 2-0: 16KB RAM — page 1 (0x4000-0x7FFF) -->
      <secondary slot="0">
        <RAM id="RAM Page 1">
          <mem base="0x4000" size="0x4000"/>
        </RAM>
      </secondary>

      <!-- Slot 2-1: 16KB RAM — page 2 (0x8000-0xBFFF) -->
      <secondary slot="1">
        <RAM id="RAM Page 2">
          <mem base="0x8000" size="0x4000"/>
        </RAM>
      </secondary>

    </primary>

    <!-- Slot 3: 16KB RAM — page 3 (0xC000-0xFFFF) -->
    <primary slot="3">
      <RAM id="RAM Page 3">
        <mem base="0xC000" size="0x4000"/>
      </RAM>
    </primary>

  </devices>

</msxconfig>
