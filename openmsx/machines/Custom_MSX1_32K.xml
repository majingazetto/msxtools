<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Custom</manufacturer>
    <code>Custom_MSX1_32K</code>
    <release_year>2026</release_year>
    <description>Custom MSX1 based on Sony HB-20P with 32KB RAM covering
pages 1+2+3 (0x4000-0xFFFF). BIOS lives in slot 0 page 0 (0x0000-0x3FFF);
RAM fills the remaining three pages. Two external cartridge ports available.
Note: although labeled 32K, the address range 0x4000-0xFFFF is 0xC000
(48KB = 3 pages x 16KB). Slot 1 and 2 are free for ROM cartridges.
  Slot 0: BIOS + BASIC ROM (0x0000-0x7FFF)
  Slot 1: external cartridge
  Slot 2: external cartridge
  Slot 3: 48KB RAM (0x4000-0xFFFF)
</description>
    <type>MSX</type>
    <region>es</region>
  </info>

  <CassettePort/>

  <devices>

    <PPI id="ppi">
      <sound>
        <volume>16000</volume>
      </sound>
      <io base="0xA8" num="4"/>
      <keyboard_type>es</keyboard_type>
      <has_keypad>false</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>T6950PAL</version>
      <io base="0x98" num="2"/>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <sound>
        <volume>21000</volume>
      </sound>
      <io base="0xA0" num="4" type="IO"/>
      <ignorePortDirections>true</ignorePortDirections>
    </PSG>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <!-- Slot 0: BIOS + BASIC ROM (pages 0 and 1, 32KB) -->
    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <rom>
          <filename>hb-20p_basic-bios1.rom</filename>
          <sha1>63050d2d21214a721cc55f152c22b7be8061ac33</sha1>
        </rom>
        <mem base="0x0000" size="0x8000"/>
      </ROM>
    </primary>

    <!-- Slot 1: external cartridge port -->
    <primary external="true" slot="1"/>

    <!-- Slot 2: external cartridge port -->
    <primary external="true" slot="2"/>

    <!-- Slot 3: RAM covering pages 1+2+3 (0x4000-0xFFFF = 0xC000 bytes) -->
    <primary slot="3">
      <RAM id="Main RAM 32K">
        <mem base="0x4000" size="0xC000"/>
      </RAM>
    </primary>

  </devices>

</msxconfig>
